    "        lml = -0.5 * (logdet_t + quad + n_source * tf.cast(tf.math.log(2*np.pi), Ax.dtype))\n",
    "        #tf.print(quad, logdet_t)\n",
    "        return tf.squeeze(lml)\n",
    "\n",
    "    def maximum_log_likelihood_objective(self):\n",
    "        return self.conditional_likelihood()\n",
